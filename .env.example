# System Environment Variables
# Copy to .env (Windows: Copy-Item .env.example .env) — never commit .env

# Database (PostgreSQL 15 + pgvector) — local dev only
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=sitedesk_db
DATABASE_URL=postgresql+psycopg2://postgres:password123@db:5432/sitedesk_db

# AI Gateway — LLM (OpenAI-compatible). Demo provider: DeepSeek. Key only in your local .env, never in repo.
# Used only for ambiguous lines; values without evidence in the line are dropped. Empty key → LLM disabled.
# Note: DeepSeek official API is NOT an EU/sovereign provider — demo only (SRS v2 §1.5).
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384

# Matching thresholds (SRS v2 §5)
MATCH_HIGH_THRESHOLD=0.90
MATCH_REVIEW_THRESHOLD=0.80
AMBIGUITY_GAP=0.05

# Fail toggles (also switchable from the UI) + connector
AI_FAIL_MODE=false
CONNECTOR_MODE=api
MOCK_POS_URL=http://mock-pos:8001
MOCK_POS_FAIL_MODE=false
DEFAULT_MARKET=DK

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Simulated demo sign-in (FR-032) - NOT SSO. Leave DEMO_PASSWORD empty and the counter still works with the default associate.
# Set a password locally (never commit it) to enable /auth/login for EMP-1042 and EMP-2077.
AUTH_REQUIRED=false
DEMO_PASSWORD=
SESSION_SECRET=
IDLE_TIMEOUT_SECONDS=300
